# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# ─── Database ───────────────────────────────────────────────────────────────
# Prisma reads DATABASE_URL. Relative paths resolve from the project root
# (i.e. from /app in Docker, or the repo root in dev).
DATABASE_URL="file:./data/sms.db"

# Legacy: same path exposed as DATABASE_PATH for our own code (cron, db index).
# Not read by Prisma itself.
DATABASE_PATH=./data/sms.db

# ─── Cron ───────────────────────────────────────────────────────────────────
# Shared secret required by both docker-compose services. Generate with:
#   openssl rand -hex 32
CRON_SECRET=replace-me-with-a-random-secret

# Set to "true" only if you want the in-process scheduler. In Docker, the
# dedicated `cron` service drives the jobs, so leave this "false".
ENABLE_CRON=false