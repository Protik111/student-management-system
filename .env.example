# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# ─── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Two variants depending on where the app runs:
#
#   - Local dev (your laptop, hitting Postgres via Docker's published port):
#       use `localhost` as the host.
#   - Inside `docker compose up` (the app container reaches Postgres via the
#     Compose network): use the service name `db` as the host.
#
# The docker-compose.yml in this repo provisions a Postgres 16 container with
# user `app`, password `app`, database `app` — both URLs below match that.
DATABASE_URL="postgresql://app:app@localhost:5432/app"
# DATABASE_URL="postgresql://app:app@db:5432/app"

# ─── Cron ───────────────────────────────────────────────────────────────────
# Shared secret required by both docker-compose services. Generate with:
#   openssl rand -hex 32
CRON_SECRET=replace-me-with-a-random-secret

# Set to "true" only if you want the in-process scheduler. In Docker, the
# dedicated `cron` service drives the jobs, so leave this "false".
ENABLE_CRON=false