// SMS — School Management System schema (Prisma + PostgreSQL)
// Same 18 tables, same constraints, same field semantics as the Drizzle version.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Datasource: provider stays here, connection details live in prisma.config.ts
// (Prisma 7 requirement).
datasource db {
  provider = "postgresql"
}

// ─── Enums (Postgres supports native enums; Prisma emits CREATE TYPE …) ─────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentSource {
  enrolled
  added
}

enum Gender {
  male
  female
  other
}

enum EnrollmentStatus {
  enrolled
  deferred
  withdrawn
  completed
}

enum ExamTerm {
  midterm
  final
  monthly
  annual
  quiz
}

enum BookIssueStatus {
  issued
  returned
  overdue
  lost
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum FeeStatus {
  pending
  partial
  paid
  overdue
  waived
  cancelled
}

enum PaymentMethod {
  cash
  bank
  card
  mobile
  cheque
  other
}

enum AssessmentStatus {
  draft
  open
  closed
  graded
}

enum SubmissionStatus {
  submitted
  late
  resubmitted
  returned
}

enum GradeClassification {
  fail
  pass
  merit
  distinction
}

enum NotificationType {
  enrollment_created
  enrollment_status_changed
  invoice_issued
  payment_received
  payment_overdue
  assessment_created
  assessment_closing_soon
  submission_received
  submission_late
  grades_published
  report_card_ready
  user_created
  password_reset
  csv_import_completed
  course_enrolled
  course_added
  material_uploaded
}

// ─── Schools ────────────────────────────────────────────────────────────────

model School {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String?
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  userRoles    UserRole[]
  programmes   Programme[]
  students     Student[]
  teachers     Teacher[]
  classes      Class[]
  subjects     Subject[]
  exams        Exam[]
  books        Book[]
  audits       AuditLog[]
  attendance   Attendance[]
  feeStructures FeeStructure[]
  invoices     Invoice[]
  payments     Payment[]
  assessments  Assessment[]
  courses      Course[]
  categories   Category[]
  materials    Material[]
}

// ─── Programmes ─────────────────────────────────────────────────────────────
// A Programme is a degree / track owned by a school (e.g. "BSc Computer
// Science"). Students belong to one Programme; fee structures are linked to
// a Programme so the brief's programme-based fee rule works.

model Programme {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  code          String
  durationYears Int      @default(4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students       Student[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  schoolId     String?
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  /// Convenience single-role column used by NextAuth JWT.
  primaryRole  Role
  lastLoginAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school          School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  student         Student?
  teacher         Teacher?
  bookIssues      BookIssue[]       @relation("BookIssueUser")
  issuedByMe      BookIssue[]       @relation("BookIssueIssuer")
  auditLogs       AuditLog[]
  notifications   Notification[]
  invoicesIssued  Invoice[]         @relation("InvoiceIssuer")
  paymentsReceived Payment[]        @relation("PaymentReceiver")
  examResultsPublished ExamResult[]  @relation("ExamResultPublisher")
  assessmentGradesEntered AssessmentGrade[] @relation("AssessmentGrader")
  materialsUploaded Material[] @relation("MaterialUploader")

  @@index([schoolId])
}

// ─── userRoles (composite PK) ───────────────────────────────────────────────

model UserRole {
  userId    String
  role      Role
  schoolId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@index([schoolId])
}

// ─── Students ───────────────────────────────────────────────────────────────

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  schoolId        String
  admissionNo     String
  programmeId     String?
  academicYear    Int?
  dateOfBirth     DateTime?
  gender          Gender?
  currentClassId  String?
  guardianName    String?
  guardianPhone   String?
  address         String?
  enrollmentDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programme     Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  currentClass  Class?         @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  examResults   ExamResult[]
  reportCards   ReportCard[]
  attendanceEntries AttendanceEntry[]
  invoices      Invoice[]
  submissions   Submission[]
  assessmentGrades AssessmentGrade[]
  courseEnrollments CourseEnrollment[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([programmeId])
  @@index([currentClassId])
  @@index([academicYear])
}

// ─── Teachers ───────────────────────────────────────────────────────────────

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique
  schoolId       String
  employeeId     String
  qualification  String?
  specialization String?
  hireDate       DateTime @default(now())
  salary         Int? // cents
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  school            School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classAssignments  ClassSubject[]
  classesAsClassTeacher Class[] @relation("ClassTeacher")
  examsEntered      ExamResult[]
  attendanceTaken   Attendance[]   @relation("AttendanceTaker")
  assessments       Assessment[]
  courses           Course[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

// ─── Classes ────────────────────────────────────────────────────────────────

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  gradeLevel     Int
  section        String   @default("A")
  capacity       Int      @default(40)
  classTeacherId String?
  academicYear   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeacher     Teacher?       @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  subjects         ClassSubject[]
  enrollments      Enrollment[]
  students         Student[]
  examSubjects     ExamSubject[]
  attendance       Attendance[]
  feeStructures    FeeStructure[]
  assessments      Assessment[]

  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
  @@index([classTeacherId])
}

// ─── Subjects ───────────────────────────────────────────────────────────────

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  examSubjects  ExamSubject[]
  assessments   Assessment[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// ─── classSubjects (join) ───────────────────────────────────────────────────

model ClassSubject {
  id            String   @id @default(cuid())
  classId       String
  subjectId     String
  teacherId     String?
  periodsPerWeek Int      @default(4)
  createdAt     DateTime @default(now())

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([teacherId])
}

// ─── Enrollments ────────────────────────────────────────────────────────────

model Enrollment {
  id           String           @id @default(cuid())
  studentId    String
  classId      String
  academicYear String
  status       EnrollmentStatus @default(enrolled)
  enrolledAt   DateTime         @default(now())
  leftAt       DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, academicYear])
  @@index([classId])
  @@index([status])
}

// ─── Exams ──────────────────────────────────────────────────────────────────

model Exam {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  term         ExamTerm
  academicYear String
  startDate    DateTime
  endDate      DateTime
  description  String?
  createdAt    DateTime @default(now())

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examSubjects ExamSubject[]
  results      ExamResult[]
  reportCards  ReportCard[]

  @@unique([schoolId, name, term, academicYear])
  @@index([schoolId])
}

// ─── examSubjects ───────────────────────────────────────────────────────────

model ExamSubject {
  id         String   @id @default(cuid())
  examId     String
  subjectId  String
  classId    String
  maxMarks   Int      @default(100)
  passMarks  Int      @default(40)
  examDate   DateTime?

  exam    Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  results ExamResult[]

  @@unique([examId, subjectId, classId])
  @@index([classId])
}

// ─── examResults ────────────────────────────────────────────────────────────

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  examSubjectId String
  studentId     String
  marksObtained Int
  grade         String?
  remarks       String?
  enteredBy     String?
  enteredAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  published     Boolean  @default(false)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?    @relation("ExamResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  exam             Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject      ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredByTeacher Teacher?    @relation(fields: [enteredBy], references: [id], onDelete: SetNull)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@index([examId])
  @@index([enteredBy])
}

// ─── reportCards ────────────────────────────────────────────────────────────

model ReportCard {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  totalMarks    Int
  obtainedMarks Int
  /// Stored as basis points (×100) to keep integer.
  percentage    Int
  grade         String?
  rank          Int?
  generatedAt   DateTime @default(now())
  pdfUrl        String?
  published     Boolean  @default(false)
  publishedAt   DateTime?

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

// ─── Books ──────────────────────────────────────────────────────────────────

model Book {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  author          String
  isbn            String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  shelfLocation   String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues BookIssue[]

  @@index([schoolId])
  @@index([title])
}

// ─── bookIssues ─────────────────────────────────────────────────────────────

model BookIssue {
  id        String          @id @default(cuid())
  bookId    String
  userId    String
  issuedBy  String?
  issuedAt  DateTime        @default(now())
  dueDate   DateTime
  returnedAt DateTime?
  fineAmount Int            @default(0) // cents
  status    BookIssueStatus @default(issued)
  notes     String?

  book           Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user           User  @relation("BookIssueUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedByUser   User? @relation("BookIssueIssuer", fields: [issuedBy], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

// ─── attendance ─────────────────────────────────────────────────────────────

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  date      DateTime
  takenBy   String?
  notes     String?
  createdAt DateTime @default(now())

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  takenByTeacher Teacher? @relation("AttendanceTaker", fields: [takenBy], references: [id], onDelete: SetNull)
  entries  AttendanceEntry[]

  @@unique([classId, date])
  @@index([schoolId])
  @@index([takenBy])
}

// ─── attendanceEntries ──────────────────────────────────────────────────────

model AttendanceEntry {
  id           String           @id @default(cuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus
  remarks      String?

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
  @@index([studentId])
}

// ─── auditLogs ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  schoolId   String?
  action     String
  entityType String
  entityId   String?
  payload    String? // JSON-encoded
  createdAt  DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([schoolId])
  @@index([createdAt])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  link            String?
  payload         String? // JSON-encoded
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([createdAt])
}

// ─── Fees & Payments ────────────────────────────────────────────────────────

model FeeStructure {
  id          String   @id @default(cuid())
  schoolId    String
  programmeId String?
  classId     String?
  name        String
  amountCents Int
  frequency   String // "termly" | "annual" | "monthly" | "one_off"
  dueDay      Int? // 1–28
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programme Programme?   @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  class     Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([schoolId])
  @@index([programmeId])
}

model Invoice {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  feeStructureId String?
  invoiceNo      String
  description    String
  amountCents    Int
  dueDate        DateTime
  status         FeeStatus @default(pending)
  issuedById     String
  issuedAt       DateTime  @default(now())
  notes          String?

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  issuedBy     User          @relation("InvoiceIssuer", fields: [issuedById], references: [id])
  payments     Payment[]

  @@unique([schoolId, invoiceNo])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id           String        @id @default(cuid())
  schoolId     String
  invoiceId    String
  amountCents  Int
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  receivedById String
  notes        String?
  receiptNo    String

  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy  User    @relation("PaymentReceiver", fields: [receivedById], references: [id])

  @@unique([schoolId, receiptNo])
  @@index([invoiceId])
  @@index([paidAt])
}

// ─── Assessments ────────────────────────────────────────────────────────────

model Assessment {
  id            String           @id @default(cuid())
  schoolId      String
  classId       String
  subjectId     String
  teacherId     String
  title         String
  module        String
  description   String?
  deadline      DateTime
  status        AssessmentStatus @default(open)
  allowResub    Boolean          @default(true)
  lateAccepted  Boolean          @default(true)
  maxMarks      Int              @default(100)
  createdAt     DateTime         @default(now())
  closedAt      DateTime?

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]
  grades      AssessmentGrade[]

  @@index([schoolId, classId, subjectId])
  @@index([deadline])
}

model Submission {
  id           String           @id @default(cuid())
  assessmentId String
  studentId    String
  fileUrl      String
  fileName     String
  fileBytes    Int
  mimeType     String
  attempt      Int              @default(1)
  status       SubmissionStatus @default(submitted)
  submittedAt  DateTime         @default(now())
  isLate       Boolean          @default(false)
  feedback     String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId, attempt])
  @@index([studentId])
}

model AssessmentGrade {
  id             String             @id @default(cuid())
  assessmentId   String
  studentId      String
  marksObtained  Int
  classification GradeClassification
  remarks        String?
  published      Boolean            @default(false)
  publishedAt    DateTime?
  enteredById    String
  enteredAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy  User       @relation("AssessmentGrader", fields: [enteredById], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

// ─── Categories (Course taxonomy) ──────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// ─── Courses ───────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String
  categoryId  String
  priceCents  Int      @default(0) // 0 = free
  teacherId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments CourseEnrollment[]
  materials   Material[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([categoryId])
  @@index([isActive])
}

// ─── Course Enrollments ────────────────────────────────────────────────────

model CourseEnrollment {
  id         String           @id @default(cuid())
  studentId  String
  courseId   String
  source     EnrollmentSource @default(enrolled)
  enrolledAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

// ─── Course Materials ──────────────────────────────────────────────────────

model Material {
  id           String   @id @default(cuid())
  schoolId     String
  courseId     String
  uploadedById String
  fileUrl      String
  fileName     String
  fileBytes    Int
  mimeType     String
  createdAt    DateTime @default(now())

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([schoolId])
  @@index([uploadedById])
}